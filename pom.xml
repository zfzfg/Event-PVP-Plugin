<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.zfzfg</groupId>
  <artifactId>event-pvp-plugin</artifactId>
  <version>1.0.9</version>
  <name>Event-PVP-Plugin</name>
  <description>Kombiniertes Event- und PvP-Wager-Plugin</description>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <purpur.api.version>26.2.build.2618-stable</purpur.api.version>
  </properties>

  <repositories>
    <repository>
      <id>purpur-repo</id>
      <url>https://repo.purpurmc.org/snapshots</url>
    </repository>
    <repository>
      <id>spigot-repo</id>
      <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
    </repository>
    <repository>
      <id>sonatype</id>
      <url>https://oss.sonatype.org/content/groups/public/</url>
    </repository>
    <repository>
      <id>jitpack.io</id>
      <url>https://jitpack.io</url>
    </repository>
    <repository>
      <id>placeholderapi</id>
      <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
    </repository>
    <repository>
      <id>codemc</id>
      <url>https://repo.codemc.org/repository/maven-public/</url>
    </repository>
    <repository>
      <id>onarandombox</id>
      <url>https://repo.onarandombox.com/content/groups/public/</url>
    </repository>
  </repositories>

  <dependencies>
    <!--
      Purpur-API 26.2 (Superset von Paper- und Bukkit-API) - passend zum Zielserver
      C:\Users\zfzfg\Documents\servers\purpur-26-2 (Build 2618).
      Bringt Adventure 5.2.0 transitiv mit; deshalb ist hier KEINE eigene
      net.kyori-Dependency noetig und auch nicht erwuenscht (siehe P1.5).
    -->
    <dependency>
      <groupId>org.purpurmc.purpur</groupId>
      <artifactId>purpur-api</artifactId>
      <version>${purpur.api.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.github.MilkBowl</groupId>
      <artifactId>VaultAPI</artifactId>
      <version>1.7</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>me.clip</groupId>
      <artifactId>placeholderapi</artifactId>
      <version>2.11.5</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>me.chancesd.pvpmanager</groupId>
      <artifactId>pvpmanager</artifactId>
      <version>4.0.8</version>
      <scope>provided</scope>
    </dependency>
    <!--
      Multiverse-Core 5.x API. Wird ausschliesslich von
      de.zfzfg.core.world.mv.Mv5WorldBackend referenziert; diese Klasse wird nur
      geladen, wenn org.mvplugins.multiverse.core.MultiverseCoreApi zur Laufzeit
      existiert. Auf MV4-Servern (oder ganz ohne Multiverse) greift stattdessen
      LegacyCommandWorldBackend, deshalb ist der Verweis hier gefahrlos.
    -->
    <dependency>
      <groupId>org.mvplugins.multiverse.core</groupId>
      <artifactId>multiverse-core</artifactId>
      <!-- 5.7.3 wegen MultiverseWorld.getOfflineWorldFolder() (kennt das Dimensions-Layout
           moderner Server). Der Aufruf ist defensiv gekapselt, aeltere 5.x laufen weiter. -->
      <version>5.7.3</version>
      <scope>provided</scope>
    </dependency>
    <!--
      InventoryBackup-API (Plugin "InventoryRestore"). Pflicht-Abhaengigkeit: das Plugin
      steht in plugin.yml unter depend, der Server startet Event-PVP-Plugin also gar nicht
      erst ohne es. Scope bleibt trotzdem provided - die API-Klassen liegen zur Laufzeit im
      InventoryBackup.jar und duerfen nicht mitgeshadet werden, sonst passen zwei Kopien
      derselben Klasse nicht zueinander.

      Das Artefakt liegt in keinem oeffentlichen Repository. Vor dem ersten Build einmalig
      aus dem InventoryRestore-Projekt installieren:
          cd .../InventoryRestore/InventoryRestore-0.0.7 && mvn -pl api -am clean install
    -->
    <dependency>
      <groupId>com.zfzfg</groupId>
      <artifactId>InventoryBackup-API</artifactId>
      <version>0.1.0</version>
      <scope>provided</scope>
    </dependency>
    <!-- Test dependencies -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.11.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>plugin.yml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>plugin.yml</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.10.1</version>
        <configuration>
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.target}</target>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <artifactSet>
                <excludes>
                  <exclude>net.kyori:*</exclude>
                  <exclude>org.purpurmc.purpur:*</exclude>
                  <exclude>io.papermc.paper:*</exclude>
                  <exclude>org.spigotmc:*</exclude>
                  <exclude>com.google.guava:*</exclude>
                  <exclude>com.google.code.gson:*</exclude>
                </excludes>
              </artifactSet>
              <relocations>
                <relocation>
                  <pattern>de.zfzfg.pvpwager</pattern>
                  <shadedPattern>de.zfzfg.eventplugin.pvp</shadedPattern>
                </relocation>
              </relocations>
              <minimizeJar>false</minimizeJar>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <argLine>-Dnet.bytebuddy.experimental=true -XX:+EnableDynamicAgentLoading</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>