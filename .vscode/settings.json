{
    "java.configuration.updateBuildConfiguration": "automatic",
    // "automatic" schaltet die Null-Analyse von Eclipse JDT ein, sobald Null-Annotationen
    // im Klassenpfad liegen. Die Bukkit/Paper-API traegt solche Annotationen nur
    // teilweise, wodurch rund 175 Falschmeldungen entstehen ("needs unchecked
    // conversion to conform to '@NonNull ...'", "Potential null pointer access" auf
    // Werten, die nie null sind). Maven/javac melden davon nichts - es ist reine
    "java.compile.nullAnalysis.mode": "disabled",
    "java.import.exclusions": [
        "**/node_modules/**",
        "**/.metadata/**",
        "**/archetype-resources/**",
        "**/META-INF/maven/**",
        "**/old-files/**"
    ],
    "files.watcherExclude": {
        "**/old-files/**": true
    }
}