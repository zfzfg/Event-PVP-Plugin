  </dependencies>
  <properties>
    <maven.compiler.target>21</maven.compiler.target>
    <paper.version.from.mockbukkit>1.21-R0.1-SNAPSHOT</paper.version.from.mockbukkit>
    <maven.compiler.source>21</maven.compiler.source>
